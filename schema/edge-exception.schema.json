{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/open-model-registry/edge-exception.schema.json",
  "title": "Open Model Registry Edge Exception",
  "type": "object",
  "required": ["schema_version", "generated_at", "target_ram_gb", "exceptions"],
  "properties": {
    "schema_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date"},
    "target_ram_gb": {"const": 16},
    "scope": {"type": "string"},
    "exceptions": {"type": "array", "items": {"$ref": "#/$defs/exception"}}
  },
  "$defs": {
    "exception": {
      "type": "object",
      "required": ["model_id", "name", "developer", "category", "total_parameters_b", "active_parameters_b", "architecture", "reason", "deployment_format", "memory_estimate_gb", "fit_status", "license", "official_checkpoint", "runtime_support", "source_url", "last_verified"],
      "properties": {
        "model_id": {"type": "string", "minLength": 3},
        "name": {"type": "string", "minLength": 1},
        "developer": {"type": "string", "minLength": 1},
        "category": {"enum": ["llm", "vlm", "ocr-vision", "coding", "audio", "image-generation", "other"]},
        "total_parameters_b": {"type": "number", "exclusiveMinimum": 12},
        "active_parameters_b": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "architecture": {"type": "string"},
        "reason": {"enum": ["active-parameter-exception", "quantized-edge-exception", "other"]},
        "deployment_format": {"type": "string"},
        "memory_estimate_gb": {"type": "number", "minimum": 0, "maximum": 16},
        "memory_basis": {"type": "string"},
        "fit_status": {"enum": ["yes", "borderline", "conditional", "no", "unknown"]},
        "license": {"type": "string", "minLength": 1},
        "official_checkpoint": {"const": true},
        "runtime_support": {"type": "array", "items": {"type": "string"}},
        "source_url": {"type": "string", "format": "uri"},
        "last_verified": {"type": "string", "format": "date"},
        "notes": {"type": "string"}
      }
    }
  }
}
